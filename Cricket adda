<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CricketAdda - Live Cricket Updates</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        header {
            background-color: #009688;
            color: white;
            padding: 15px;
            text-align: center;
            font-size: 20px;
            font-weight: bold;
        }
        .container {
            padding: 15px;
            max-width: 800px;
            margin: auto;
        }
        .live-match-card {
            background: white;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            border-left: 5px solid #009688;
        }
        .live-match-card h3 {
            margin-top: 0;
            color: #333;
        }
        .news-card {
            background: white;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>

    <header>
        CricketAdda
    </header>

    <div class="container">
        <!-- Live Match Box -->
        <div class="live-match-card">
            <h3>🔴 Live Match Update</h3>
            <div id="match-box">Match details load ho rahi hain...</div>
        </div>

        <!-- Sample News Card -->
        <div class="news-card">
            <h3>Harmanpreet's leadership legacy is bigger than the trophy she won</h3>
            <p>She was never the perfect captain, but her greatest contribution may have been making India believe...</p>
            <small style="color: gray;">2 hours ago</small>
        </div>
    </div>

    <!-- Live Match JavaScript Code (API Key included) -->
    <script>
        const apiKey = '6c784817-838d-4553-bef4-22c0c02c38df'; 
        const url = `https://api.cricapi.com/v1/currentMatches?apikey=${apiKey}&offset=0`;

        fetch(url)
          .then(response => response.json())
          .then(data => {
            if(data.data && data.data.length > 0) {
              const matchName = data.data[0].name;
              document.getElementById('match-box').innerText = matchName;
            } else {
              document.getElementById('match-box').innerText = 'Filhal koi live match uplabdh nahi hai.';
            }
          })
          .catch(error => {
            console.error('Error:', error);
            document.getElementById('match-box').innerText = 'Data load karne me koi samasya aayi hai.';
          });
    </script>

</body>
</html>
